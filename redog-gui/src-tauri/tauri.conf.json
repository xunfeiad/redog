{
  "productName": "Redog",
  "version": "0.1.0",
  "identifier": "com.redog.app",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 700,
        "resizable": true,
        "title": "Redog Dashboard",
        "width": 1000,
        "visible": false,
        "decorations": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Network",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "macOS": {
      "entitlements": null,
      "frameworks": []
    },
    "windows": {
      "digestAlgorithm": "sha256"
    }
  }
}
